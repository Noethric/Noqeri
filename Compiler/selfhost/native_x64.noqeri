module noqeri.compiler.selfhost.native_x64
import "nir.noqeri"
import "ast.noqeri"
import "types.noqeri"
import "targets.noqeri"

export function nqNativeX64Ok(): isize { return 0 as isize }
export function nqNativeX64Capacity(): isize { return -900 as isize }
export function nqNativeX64Unsupported(): isize { return -901 as isize }
export function nqNativeX64Invalid(): isize { return -902 as isize }

function nqX64Put(out: []u8, cursor: *usize, data: []u8): bool {
    if cursor == null { return false }
    let at: usize = 0 as usize
    unsafe { at = cursor[0] }
    if at > len(out) || len(data) > len(out) - at { return false }
    let i: usize = 0 as usize
    while i < len(data) { out[at + i] = data[i] i = i + 1 as usize }
    unsafe { cursor[0] = at + len(data) }
    return true
}

function nqX64PutSpan(out: []u8, cursor: *usize, source: []u8, start: usize, end: usize): bool {
    if start >= end || end > len(source) { return false }
    let at: usize = 0 as usize
    unsafe { at = cursor[0] }
    if at > len(out) || end - start > len(out) - at { return false }
    let i: usize = start
    while i < end { out[at + (i - start)] = source[i] i = i + 1 as usize }
    unsafe { cursor[0] = at + (end - start) }
    return true
}

function nqX64PutU64(out: []u8, cursor: *usize, value: u64): bool {
    let digits: [u8; 32]
    let count: usize = 0 as usize
    let current: u64 = value
    if current == 0 as u64 { return nqX64Put(out, cursor, slice([48 as u8])) }
    while current > 0 as u64 {
        if count >= 32 as usize { return false }
        digits[count] = (48 as u64 + current % 10 as u64) as u8
        count = count + 1 as usize
        current = current / 10 as u64
    }
    let at: usize = 0 as usize
    unsafe { at = cursor[0] }
    if at > len(out) || count > len(out) - at { return false }
    let i: usize = 0 as usize
    while i < count { out[at + i] = digits[count - 1 as usize - i] i = i + 1 as usize }
    unsafe { cursor[0] = at + count }
    return true
}

function nqX64HexDigit(value: u8): u8 { if value < 10 as u8 { return 48 as u8 + value } return 87 as u8 + value }

function nqX64PutHexU64(out: []u8, cursor: *usize, value: u64): bool {
    if !nqX64Put(out, cursor, slice([48 as u8,120 as u8])) { return false }
    let divisor: u64 = 1152921504606846976 as u64
    let index: usize = 0 as usize
    while index < 16 as usize {
        let digit: u8 = ((value / divisor) % 16 as u64) as u8
        let at: usize = 0 as usize
        unsafe { at = cursor[0] }
        if at >= len(out) { return false }
        out[at] = nqX64HexDigit(digit)
        unsafe { cursor[0] = at + 1 as usize }
        if divisor > 1 as u64 { divisor = divisor / 16 as u64 }
        index = index + 1 as usize
    }
    return true
}

function nqX64SpanEqual(source: []u8, start: usize, end: usize, value: []u8): bool {
    if end < start || end - start != len(value) || end > len(source) { return false }
    let i: usize = 0 as usize
    while i < len(value) { if source[start + i] != value[i] { return false } i = i + 1 as usize }
    return true
}

function nqX64MaxRegister(instructions: []NqNirInstruction, function: *NqNirFunction): usize {
    let maximum: isize = -1 as isize
    let i: usize = function.firstInstruction
    let end: usize = function.firstInstruction + function.instructionCount
    while i < end {
        if instructions[i].dest > maximum { maximum = instructions[i].dest }
        if instructions[i].left > maximum { maximum = instructions[i].left }
        if instructions[i].right > maximum { maximum = instructions[i].right }
        i = i + 1 as usize
    }
    if maximum < 0 as isize { return 0 as usize }
    return maximum as usize + 1 as usize
}

function nqX64SymbolIndex(symbols: []u64, count: usize, symbol: u64): isize {
    let i: usize = 0 as usize
    while i < count { if symbols[i] == symbol { return i as isize } i = i + 1 as usize }
    return -1 as isize
}

function nqX64CollectSymbols(instructions: []NqNirInstruction, function: *NqNirFunction, symbols: []u64, outCount: *usize): bool {
    if outCount == null { return false }
    let count: usize = 0 as usize
    let i: usize = function.firstInstruction
    let end: usize = function.firstInstruction + function.instructionCount
    while i < end {
        let op: int = instructions[i].opcode
        if (op == nqNirLoad() || op == nqNirStore() || op == nqNirAddr() || op == nqNirParameter()) && instructions[i].symbol != 0 as u64 {
            if nqX64SymbolIndex(symbols, count, instructions[i].symbol) < 0 as isize {
                if count >= len(symbols) { return false }
                symbols[count] = instructions[i].symbol
                count = count + 1 as usize
            }
        }
        i = i + 1 as usize
    }
    unsafe { outCount[0] = count }
    return true
}

function nqX64RegType(instructions: []NqNirInstruction, function: *NqNirFunction, reg: isize): int {
    if reg < 0 as isize { return nqAstTypeUnknown() }
    let i: usize = function.firstInstruction
    let end: usize = function.firstInstruction + function.instructionCount
    while i < end { if instructions[i].dest == reg { return instructions[i].typeCode } i = i + 1 as usize }
    return nqAstTypeUnknown()
}

function nqX64MakeSliceBefore(instructions: []NqNirInstruction, function: *NqNirFunction, pc: usize): usize {
    let count: usize = 0 as usize
    let i: usize = function.firstInstruction
    while i <= pc && i < function.firstInstruction + function.instructionCount { if instructions[i].opcode == nqNirMakeSlice() { count = count + 1 as usize } i = i + 1 as usize }
    return count
}

function nqX64FrameBytes(instructions: []NqNirInstruction, function: *NqNirFunction, variableCount: usize): usize {
    let registerCount: usize = nqX64MaxRegister(instructions, function)
    let sliceCount: usize = 0 as usize
    let i: usize = function.firstInstruction
    let end: usize = function.firstInstruction + function.instructionCount
    while i < end { if instructions[i].opcode == nqNirMakeSlice() { sliceCount = sliceCount + 1 as usize } i = i + 1 as usize }
    let bytesCount: usize = (registerCount + variableCount) * 8 as usize + sliceCount * 16 as usize
    let rem: usize = bytesCount % 16 as usize
    if rem == 0 as usize { return bytesCount }
    return bytesCount + (16 as usize - rem)
}

function nqX64PutRegSlot(out: []u8, cursor: *usize, reg: isize): bool {
    if reg < 0 as isize { return false }
    if !nqX64Put(out, cursor, slice([81 as u8,87 as u8,79 as u8,82 as u8,68 as u8,32 as u8,80 as u8,84 as u8,82 as u8,32 as u8,91 as u8,114 as u8,98 as u8,112 as u8,45 as u8])) || !nqX64PutU64(out, cursor, (reg as u64 + 1 as u64) * 8 as u64) { return false }
    return nqX64Put(out, cursor, slice([93 as u8]))
}

function nqX64PutVarSlot(out: []u8, cursor: *usize, registerCount: usize, variableIndex: usize): bool {
    if !nqX64Put(out, cursor, slice([81 as u8,87 as u8,79 as u8,82 as u8,68 as u8,32 as u8,80 as u8,84 as u8,82 as u8,32 as u8,91 as u8,114 as u8,98 as u8,112 as u8,45 as u8])) || !nqX64PutU64(out, cursor, (registerCount as u64 + variableIndex as u64 + 1 as u64) * 8 as u64) { return false }
    return nqX64Put(out, cursor, slice([93 as u8]))
}

function nqX64PutPcLabel(out: []u8, cursor: *usize, function: *NqNirFunction, pc: usize): bool {
    if !nqX64Put(out, cursor, slice([46 as u8,76 as u8,102 as u8,110 as u8,95 as u8])) || !nqX64PutU64(out, cursor, function.symbol) || !nqX64Put(out, cursor, slice([95 as u8])) { return false }
    return nqX64PutU64(out, cursor, pc as u64)
}

function nqX64PutStringLabel(out: []u8, cursor: *usize, index: usize): bool {
    if !nqX64Put(out, cursor, slice([46 as u8,76 as u8,115 as u8,116 as u8,114 as u8,95 as u8])) { return false }
    return nqX64PutU64(out, cursor, index as u64)
}

function nqX64FindFunction(functions: []NqNirFunction, symbol: u64): isize {
    let i: usize = 0 as usize
    while i < len(functions) { if functions[i].symbol == symbol { return i as isize } i = i + 1 as usize }
    return -1 as isize
}

function nqX64EmitLoadReg(out: []u8, cursor: *usize, cpu: []u8, reg: isize): bool {
    if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8])) || !nqX64Put(out, cursor, cpu) || !nqX64Put(out, cursor, slice([44 as u8,32 as u8])) || !nqX64PutRegSlot(out, cursor, reg) { return false }
    return nqX64Put(out, cursor, slice([10 as u8]))
}

function nqX64EmitStoreReg(out: []u8, cursor: *usize, reg: isize, cpu: []u8): bool {
    if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8])) || !nqX64PutRegSlot(out, cursor, reg) || !nqX64Put(out, cursor, slice([44 as u8,32 as u8])) || !nqX64Put(out, cursor, cpu) { return false }
    return nqX64Put(out, cursor, slice([10 as u8]))
}

function nqX64EmitCallArgLoad(out: []u8, cursor: *usize, index: usize, reg: isize): bool {
    if index == 0 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,100 as u8,105 as u8]), reg) }
    if index == 1 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,115 as u8,105 as u8]), reg) }
    if index == 2 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,100 as u8,120 as u8]), reg) }
    if index == 3 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,99 as u8,120 as u8]), reg) }
    if index == 4 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,56 as u8]), reg) }
    if index == 5 as usize { return nqX64EmitLoadReg(out, cursor, slice([114 as u8,57 as u8]), reg) }
    return false
}

function nqX64EmitParameterStore(out: []u8, cursor: *usize, index: usize, reg: isize): bool {
    if index == 0 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,100 as u8,105 as u8,10 as u8])) { return false } }
    else if index == 1 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,115 as u8,105 as u8,10 as u8])) { return false } }
    else if index == 2 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,100 as u8,120 as u8,10 as u8])) { return false } }
    else if index == 3 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,99 as u8,120 as u8,10 as u8])) { return false } }
    else if index == 4 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,56 as u8,10 as u8])) { return false } }
    else if index == 5 as usize { if !nqX64Put(out, cursor, slice([32 as u8,32 as u8,32 as u8,32 as u8,109 as u8,111 as u8,118 as u8,32 as u8,114 as u8,97 as u8,120 as u8,44 as u8,32 as u8,114 as u8,57 as u8,10 as u8])) { return false } }
    else { return false }
    return nqX64EmitStoreReg(out, cursor, reg, slice([114 as u8,97 as u8,120 as u8]))
}

function nqX64EmitFunctionName(out: []u8, cursor: *usize, source: []u8, function: *NqNirFunction): bool {
    if function.symbol == 4294967296 as u64 { return nqX64Put(out, cursor, slice([109 as u8,97 as u8,105 as u8,110 as u8])) }
    return nqX64PutSpan(out, cursor, source, function.nameStart, function.nameEnd)
}

function nqX64EmitCallName(out: []u8, cursor: *usize, source: []u8, instruction: *NqNirInstruction): bool {
    return nqX64PutSpan(out, cursor, source, instruction.sourceStart, instruction.sourceEnd)
}

function nqX64FloatBits(value: *float): u64 {
    if value == null { return 0 as u64 }
    let bits: u64 = 0 as u64
    unsafe { let p: *u64 = value as *u64 bits = p[0] }
    return bits
}

function nqX64EmitRuntime(out: []u8, cursor: *usize): bool {
    return nqX64Put(out, cursor, slice([10 as u8,46 as u8,101 as u8,120 as u8,116 as u8,101 as u8,114 as u8,110 as u8,32 as u8,99 as u8,97 as u8,108 as u8,108 as u8,111 as u8,99 as u8,10 as u8,46 as u8,101 as u8,120 as u8,116 as u8,101 as u8,114 as u8,110 as u8,32 as u8,112 as u8,114 as u8,105 as u8,110 as u8,116 as u8,102 as u8,10 as u8,46 as u8,116 as u8,101 as u8,120 as u8,116 as u8,10 as u8,110 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,95 as u8,114 as u8,116 as u8,95 as u8,116 as u8,101 as u8,120 as u8,116 as u8,95 as u8,108 as u8,101 as u8,110 as u8,103 as u8,116 as u8,104 as u8,58 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,120 as u8,111 as u8,114 as u8,32 as u8,101 as u8,97 as u8,120 as u8,44 as u8,32 as u8,101 as u8,97 as u8,120 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,116 as u8,101 as u8,115 as u8,116 as u8,32 as u8,114 as u8,100 as u8,105 as u8,44 as u8,32 as u8,114 as u8,100 as u8,105 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,106 as u8,122 as u8,32 as u8,46 as u8,76 as u8,114 as u8,116 as u8,95 as u8,115 as u8,116 as u8,114 as u8,108 as u8,101 as u8,110 as u8,95 as u8,100 as u8,111 as u8,110 as u8,101 as u8,10 as u8,46 as u8,76 as u8,114 as u8,116 as u8,95 as u8,115 as u8,116 as u8,114 as u8,108 as u8,101 as u8,110 as u8,95 as u8,108 as u8,111 as u8,111 as u8,112 as u8,58 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,99 as u8,109 as u8,112 as u8,32 as u8,66 as u8,89 as u8,84 as u8,69 as u8,32 as u8,80 as u8,84 as u8,82 as u8,32 as u8,91 as u8,114 as u8,100 as u8,105 as u8,43 as u8,114 as u8,97 as u8,120 as u8,93 as u8,44 as u8,32 as u8,48 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,106 as u8,101 as u8,32 as u8,46 as u8,76 as u8,114 as u8,116 as u8,95 as u8,115 as u8,116 as u8,114 as u8,108 as u8,101 as u8,110 as u8,95 as u8,100 as u8,111 as u8,110 as u8,101 as u8,10 as u8,32 as u8,32 as u8,32 as u8,32 as u8,105 as u8,110 as u8,99 as u8,32 as u8,114 as u8,97 as u8,120 as u8,10 as u8,32 as u8,32 as u8,32 a